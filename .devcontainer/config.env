# Project settings for the dev container scripts. Sourced by .devcontainer/lib.sh; no secrets.
#
# Everything project-specific about the development environment lives here, in the "name" and
# extension list of devcontainer.json, and in the toolchain stage of the Dockerfile. The other
# files in .devcontainer/ are meant to work unchanged in any project.
#
# Each value can be overridden from the environment, e.g. for one autonomous run:
#   devcontainer up --workspace-folder . --remote-env AGENT_FIREWALL=1

# Installs the project's dependencies into the image's environment. Runs on container creation
# and when setup.sh serves as the setup script of an environment that does not build our image.
: "${PROJECT_SETUP:=poetry install --with dev,docs,agents --all-extras}"

# Which account each agent CLI uses in this repository: "api" or "subscription".
#   api           pay per token. Provide ANTHROPIC_API_KEY / OPENAI_API_KEY as Codespaces
#                 secrets or in the environment of the run; setup logs Codex in with its key.
#   subscription  Claude Pro/Max or ChatGPT plan. Log in once inside the container (the login is
#                 kept in a volume), or provide CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`.
# A set ANTHROPIC_API_KEY always wins over a Claude subscription login, so setup warns when it is
# set in subscription mode, and profile.sh unsets it in interactive shells.
# Default is subscription for every agent, including ones added later as <AGENT>_AUTH: in VS
# Code people log in through the agents' extensions. Unattended runs that bill to a key set
# <AGENT>_AUTH=api in their environment.
: "${CLAUDE_AUTH:=subscription}"
: "${CODEX_AUTH:=subscription}"

# Outbound firewall: 1 limits traffic to the domains in root/firewall-allow.txt, 0 leaves it
# open. Empty lets the environment hook in environments/ choose. Once on, it stays on until
# the container restarts; agents cannot switch it off.
: "${AGENT_FIREWALL:=}"
